[Unit]
Description=Home Connect (local) to MQTT bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hcbridge
Group=hcbridge

ExecStart=/opt/hcbridge/hcbridge --mode=run --config=/etc/hcbridge/config.yaml

# -------------------------------------------------------------------
# Restart policy
# -------------------------------------------------------------------
Restart=always
RestartSec=10
# Room for the Close handshake with the hob on stop.
TimeoutStopSec=15

# -------------------------------------------------------------------
# Security Hardening
# -------------------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=

ReadOnlyPaths=/opt/hcbridge /etc/hcbridge
StateDirectory=hcbridge
StateDirectoryMode=0700
LogsDirectory=hcbridge
LogsDirectoryMode=0700
UMask=0077

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6
DevicePolicy=closed
PrivateDevices=true
ProtectProc=invisible
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true

SystemCallFilter=@system-service
RestrictSUIDSGID=yes
LockPersonality=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
